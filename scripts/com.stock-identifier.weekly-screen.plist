<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stock-identifier.weekly-screen</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/maulikshah/projects/stock-identifier/scripts/weekly-screen.sh</string>
  </array>
  <!-- Saturday 09:00 local time (IST), after Friday's close. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>6</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
