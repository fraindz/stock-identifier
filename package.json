{
  "name": "stock-identifier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "screen": "tsx scripts/screen.ts",
    "schedule:install": "cp scripts/com.stock-identifier.weekly-screen.plist ~/Library/LaunchAgents/com.stock-identifier.weekly-screen.plist && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.stock-identifier.weekly-screen.plist",
    "schedule:uninstall": "launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.stock-identifier.weekly-screen.plist; rm -f ~/Library/LaunchAgents/com.stock-identifier.weekly-screen.plist"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "yahoo-finance2": "^4.0.5"
  }
}
