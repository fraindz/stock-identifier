rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /weeklyHistory/{document} {
      allow read: if true;
      allow create, update: if
        request.resource.data.trend in ['down', 'up'] &&
        request.resource.data.weekStart is string &&
        request.resource.data.savedAt is string &&
        request.resource.data.week is map &&
        request.resource.data.symbols is list &&
        request.resource.data.symbols.size() <= 2000;
    }
  }
}
